# Discord bot configuration
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Discord server configuration
DISCORD_GUILD_ID=

# Channels
JOIN_TO_CREATE_CHANNEL_ID=
CREW_LOG_CHANNEL_ID=
ACCESS_CHANNEL_ID=
CS_CATEGORY_ID=
CS_LOBBY_CHANNEL_ID=
CS_MAIN_TOURNAMENT_ID=
CS_WINGMAN_TOURNAMENT_ID=
CS_WEBHOOK_PORT=8787
CS_WEBHOOK_BIND_ADDRESS=127.0.0.1
MAT_WEBHOOK_SECRET=

# Roles
CREW_ROLE_ID=
# Automatic website-verified access role (discord-koblet).
ACCESS_ROLE_ID=
# Manual private-server access role assigned by /giveaccess (tilgang-manuell).
MANUAL_ACCESS_ROLE_ID=
# Automatic tournament-enrollment role for CS.
CS_PARTICIPANT_ROLE_ID=
# Manual CS category access, independent of API enrollment or Steam linking.
MANUAL_CS_PARTICIPANT_ROLE_ID=
# Role sync: checks NT-LAN tournament enrollment and manages only CS_PARTICIPANT_ROLE_ID.
# false disables automatic role checks; it does not affect voice sync.
CS_ROLE_SYNC_ENABLED=false
# true logs planned role changes without editing Discord roles.
# false applies role additions/removals when role sync is enabled.
CS_ROLE_SYNC_DRY_RUN=true
# Voice sync: handles MAT events to create/update bot-owned rooms and move assigned members.
# false disables all automatic voice-room and member-move actions, independently of role sync.
CS_VOICE_SYNC_ENABLED=false
# true plans voice changes without editing rooms or moving members.
# false applies voice changes when voice sync is enabled.
CS_VOICE_SYNC_DRY_RUN=true

# Nickname API
REGISTRATION_API_URL=
REGISTRATION_TOKEN_URL=
REGISTRATION_CLIENT_ID=
REGISTRATION_CLIENT_SECRET=

# MAT API
MAT_URL=
MAT_API_TOKEN=

# Annet
EMPTY_CHANNEL_DELETE_DELAY_MS=10000
REGISTRATION_URL=https://ntlan.no/

# Access control: channel permissions are managed manually in Discord
ACCESS_DRY_RUN=true
ACCESS_SYNC_INTERVAL_MS=15000
# How often (milliseconds) the bot checks NT-LAN enrollment and runs MAT voice recovery.
CS_SYNC_INTERVAL_MS=300000
# Deprecated fallback for CS_VOICE_SYNC_DRY_RUN; use the voice-specific setting above.
# CS_SYNC_DRY_RUN=true
