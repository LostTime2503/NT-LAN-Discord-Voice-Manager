DISCORD_TOKEN=sett_inn_token_lokalt
DISCORD_CLIENT_ID=sett_inn_application_id
DISCORD_GUILD_ID=sett_inn_testserver_id
JOIN_TO_CREATE_CHANNEL_ID=sett_inn_kanal_id_etter_setup
CS_TEAM_CATEGORY_ID=sett_inn_cs_lag_kategori_id_etter_setup

# Valgfri: kanal-ID der boten sender online/offline-meldinger, f.eks. #bot-log.
# Meldingen sendes KUN til denne ene kanalen, ikke til hele serveren. Tom verdi = ingen melding sendes.
CREW_LOG_CHANNEL_ID=

# Valgfri: kanal-ID der boten onsker nye medlemmer velkommen med en "sett kallenavn"-knapp.
# Tom verdi = velkomstmeldingen sendes ikke.
WELCOME_CHANNEL_ID=

# Rolle-ID for Crew. Denne rollen og roller over den kan bruke crew-begrensede kommandoer.
CREW_ROLE_ID=

# Valgfri: kanal-ID for registreringsknappen og matvarsler.
MODAL_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=

# Brukes senere for automatisk sletting av tomme midlertidige kanaler.
EMPTY_CHANNEL_DELETE_DELAY_MS=300000

# Konkurransesynk er av som standard. Sett ENABLE_TEAM_SYNC=true for a aktivere den.
ENABLE_TEAM_SYNC=false
# Behold API-innstillingene for eventuell senere bruk; de brukes ikke nar synken er av.
# MAT_API_TOKEN skal vaere et read-only service-token, aldri admin-token.
MAT_URL=
MAT_API_TOKEN=